# Copy to .env and set a long random value.
# Guards the admin routes; unset means every admin route returns 503.
ADMIN_TOKEN=

# Optional. Only set these if the backend cannot reach Ollama on its own localhost,
# or the frontend is served from a port other than 3000. Docker Compose sets both
# itself, so leave them blank here -- a value in .env would also apply to local runs.
# OLLAMA_BASE_URL=http://localhost:11434
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
